{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Windows, updates and external links: desktop only.",
  "platforms": [
    "linux",
    "macOS",
    "windows"
  ],
  "windows": [
    "main",
    "composite-view"
  ],
  "permissions": [
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-always-on-top",
    "core:window:allow-destroy",
    "updater:default",
    "process:default",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://didascalie.readthedocs.io/*"
        },
        {
          "url": "https://github.com/ClementPla/Didascalie/blob/release/THIRD_PARTY_NOTICES.md"
        }
      ]
    }
  ]
}
